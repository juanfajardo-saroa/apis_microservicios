## Ignore Visual Studio temporary files, build results, and files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Tt]emp/

# Visual Studio 2022 cache/options directory
.vs/

# DotNet artifacts
project.lock.json
project.fragment.lock.json
artifacts/

# Environment files
*.env
*.env.*

# Local app settings and secrets
appsettings.Development.json
appsettings.Local.json
launchSettings.json
secrets.json
*.Secret.json

# Azure or sensitive configs
*.azure.*
*.keyvault.json

# Logs
*.log
*.tlog

# Others
.idea/
.vscode/
.DS_Store

# Package directories
node_modules/
packages/
wwwroot/lib/

# Backup and temporary files
*.bak
*.tmp
*.old
